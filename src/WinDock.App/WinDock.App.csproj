<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinDock.App</RootNamespace>
    <AssemblyName>WinDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinDock.Core\WinDock.Core.csproj" />
    <ProjectReference Include="..\WinDock.Shell\WinDock.Shell.csproj" />
    <ProjectReference Include="..\WinDock.Providers\WinDock.Providers.csproj" />
    <ProjectReference Include="..\WinDock.Widgets\WinDock.Widgets.csproj" />
    <ProjectReference Include="..\WinDock.Infrastructure\WinDock.Infrastructure.csproj" />
  </ItemGroup>
</Project>
