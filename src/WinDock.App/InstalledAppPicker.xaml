<Window x:Class="WinDock.App.InstalledAppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinDock.App"
        xmlns:core="clr-namespace:WinDock.Core;assembly=WinDock.Core"
        xmlns:widgets="clr-namespace:WinDock.Widgets;assembly=WinDock.Widgets"
        Title="Add app"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="{x:Static widgets:UiFont.Family}"
        Background="#FFF4F4F6">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Settings/SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="AppRowTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Margin="0,0,12,0">
                        <Grid>
                            <widgets:PhosphorGlyph Icon="app-window" Width="16" Height="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                                                   Foreground="{DynamicResource Settings.Text}"
                                                   Visibility="{Binding GlyphVisibility}"/>
                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LetterRowTemplate">
                <TextBlock Text="{Binding Letter}" FontSize="{x:Static core:DockTokens.SecondaryFontSize}"
                           FontWeight="SemiBold" Margin="4,8,0,2"
                           Foreground="{DynamicResource Settings.Muted}"/>
            </DataTemplate>
            <local:PickerTemplateSelector x:Key="PickerTemplates"
                                           AppTemplate="{StaticResource AppRowTemplate}"
                                           LetterTemplate="{StaticResource LetterRowTemplate}"/>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="{StaticResource Settings.PageInset}">
        <TextBlock x:Name="PickerTitle" DockPanel.Dock="Top" Text="从开始菜单选择程序" Style="{StaticResource Settings.Title}" Margin="{StaticResource Settings.SectionGap}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Settings.Button}" MinWidth="88" Margin="{StaticResource Settings.ButtonGap}" Click="Cancel_OnClick"/>
            <Button x:Name="AddButton" Content="添加" Style="{StaticResource Settings.PrimaryButton}" MinWidth="88" IsDefault="True" Click="Add_OnClick"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border x:Name="SearchHost" DockPanel.Dock="Top" Background="#FFE8E8EC" CornerRadius="4" Padding="12,8" Margin="0,0,0,16">
                    <DockPanel>
                        <widgets:PhosphorGlyph DockPanel.Dock="Left" Icon="magnifying-glass" Width="12" Height="12"
                                               Opacity="0.45" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Settings.Muted}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     TextChanged="SearchBox_OnTextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索应用程序…" IsHitTestVisible="False"
                                       Foreground="#6F6F76" Opacity="0.7" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="AppList" Grid.Column="0"
                             SelectionMode="Extended"
                             ItemTemplateSelector="{StaticResource PickerTemplates}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.CacheLength="1,1"
                             MouseDoubleClick="Available_OnMouseDoubleClick"
                             SelectionChanged="Lists_OnSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Settings.ListBoxItem}">
                                <EventSetter Event="Loaded" Handler="RowContainer_OnLoaded"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <UniformGrid x:Name="AvailableIndex" Grid.Column="1" Columns="1"/>
                </Grid>
            </DockPanel>

            <StackPanel x:Name="ShuttleButtons" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="ToChosenButton" Style="{StaticResource Settings.Button}" Width="32" MinWidth="32" Padding="0"
                        ToolTip="加入已选择" Click="ToChosen_OnClick">
                    <widgets:PhosphorGlyph Icon="caret-right" Width="14" Height="14"/>
                </Button>
                <Button x:Name="ToAvailableButton" Style="{StaticResource Settings.Button}" Width="32" MinWidth="32" Padding="0"
                        ToolTip="移出" Click="ToAvailable_OnClick">
                    <widgets:PhosphorGlyph Icon="caret-left" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="ChosenTitle" DockPanel.Dock="Top" Text="已选择 · 0" Style="{StaticResource Settings.Label}" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <ListBox x:Name="ChosenList"
                                 SelectionMode="Extended"
                                 ItemTemplateSelector="{StaticResource PickerTemplates}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 MouseDoubleClick="Chosen_OnMouseDoubleClick"
                                 SelectionChanged="Lists_OnSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Settings.ListBoxItem}">
                                    <EventSetter Event="Loaded" Handler="RowContainer_OnLoaded"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="ChosenEmpty" Text="从左侧加入程序" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Settings.Muted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid x:Name="ChosenIndex" Grid.Column="1" Columns="1"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
