<Window x:Class="WinDock.App.InstalledAppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加程序"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FFF4F4F6">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Settings/SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="AppRowTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                                       Visibility="{Binding GlyphVisibility}"/>
                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="开始菜单里的程序" Style="{StaticResource Settings.Title}" Margin="0,0,0,16"/>
        <Border x:Name="SearchHost" DockPanel.Dock="Top" Background="#FFE8E8EC" CornerRadius="4" Padding="12,8" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Opacity="0.45" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid>
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" FontSize="13"
                             TextChanged="SearchBox_OnTextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索程序" IsHitTestVisible="False"
                               Foreground="#6F6F76" Opacity="0.7" FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Settings.Button}" MinWidth="88" Margin="{StaticResource Settings.ButtonGap}" Click="Cancel_OnClick"/>
            <Button x:Name="AddButton" Content="添加" Style="{StaticResource Settings.PrimaryButton}" MinWidth="88" IsDefault="True" Click="Add_OnClick"/>
        </StackPanel>
        <ListBox x:Name="AppList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLengthUnit="Page"
                 VirtualizingPanel.CacheLength="1,1"
                 ScrollViewer.CanContentScroll="True"
                 ItemTemplate="{StaticResource AppRowTemplate}"
                 MouseDoubleClick="AppList_OnMouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Settings.ListBoxItem}">
                    <EventSetter Event="Loaded" Handler="RowContainer_OnLoaded"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
