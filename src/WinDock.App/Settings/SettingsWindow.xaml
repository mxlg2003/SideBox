<Window x:Class="WinDock.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinDock.App"
        Title="WinDock"
        Width="1000"
        Height="680"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FFF4F4F6">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="NavPane" Grid.Column="0"
                Background="#FFF4F5F7"
                BorderBrush="#14000000"
                BorderThickness="0,0,1,0"
                Padding="12">
            <DockPanel>
                <TextBlock x:Name="NavTitle" DockPanel.Dock="Top" Text="设置" Style="{StaticResource Settings.NavTitle}"/>
                <Button x:Name="NavExitButton" DockPanel.Dock="Bottom" Margin="0,16,0,0"
                        Style="{StaticResource Settings.DangerButton}"
                        Click="NavExit_OnClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavExitLabel" Text="退出 WinDock" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="NavGroupDock" Text="Dock" Style="{StaticResource Settings.NavGroup}" Margin="8,0,8,8"/>
                        <RadioButton x:Name="NavModules" GroupName="SettingsPage" Tag="modules"
                                     Style="{StaticResource Settings.NavItem}"
                                     AutomationProperties.Name="模块"
                                     Checked="Nav_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Settings.NavGlyph}"/>
                                <TextBlock x:Name="NavModulesLabel" Text="模块" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLayout" GroupName="SettingsPage" Tag="layout"
                                     Style="{StaticResource Settings.NavItem}"
                                     AutomationProperties.Name="布局"
                                     Checked="Nav_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource Settings.NavGlyph}"/>
                                <TextBlock x:Name="NavLayoutLabel" Text="布局" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock x:Name="NavGroupDisplay" Text="显示" Style="{StaticResource Settings.NavGroup}"/>
                        <RadioButton x:Name="NavAppearance" GroupName="SettingsPage" Tag="appearance"
                                     Style="{StaticResource Settings.NavItem}"
                                     AutomationProperties.Name="外观"
                                     Checked="Nav_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" Style="{StaticResource Settings.NavGlyph}"/>
                                <TextBlock x:Name="NavAppearanceLabel" Text="外观" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock x:Name="NavGroupSystem" Text="系统" Style="{StaticResource Settings.NavGroup}"/>
                        <RadioButton x:Name="NavPrivacy" GroupName="SettingsPage" Tag="privacy"
                                     Style="{StaticResource Settings.NavItem}"
                                     AutomationProperties.Name="隐私"
                                     Checked="Nav_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Settings.NavGlyph}"/>
                                <TextBlock x:Name="NavPrivacyLabel" Text="隐私" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" GroupName="SettingsPage" Tag="about"
                                     Style="{StaticResource Settings.NavItem}"
                                     AutomationProperties.Name="关于"
                                     Checked="Nav_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Settings.NavGlyph}"/>
                                <TextBlock x:Name="NavAboutLabel" Text="关于" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <StackPanel x:Name="AdvancedGroup">
                            <TextBlock x:Name="NavGroupAdvanced" Text="高级" Style="{StaticResource Settings.NavGroup}"/>
                            <RadioButton x:Name="NavProfiles" GroupName="SettingsPage" Tag="profiles"
                                         Style="{StaticResource Settings.NavItem}"
                                         AutomationProperties.Name="情景"
                                         Checked="Nav_OnChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Settings.NavGlyph}"/>
                                    <TextBlock x:Name="NavProfilesLabel" Text="情景" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <DockPanel x:Name="PageModules" Visibility="Visible">
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16">
                    <TextBlock x:Name="ModulesTitle" Text="模块" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="ModulesHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                               Text="把时钟、便笺等加到边缘岛上。"/>
                </StackPanel>
                <local:WidgetPicker x:Name="WidgetPicker"/>
            </DockPanel>

            <ScrollViewer x:Name="PageLayout" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Settings.PageInset}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="LayoutTitle" Text="布局" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="LayoutIntro" Style="{StaticResource Settings.Help}" Margin="0,8,0,24"
                               Text="配置屏幕停靠边缘、目标显示器，以及空闲时的自动隐藏行为。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="EdgeLabel" Text="边缘位置" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.LabelGap}"/>
                            <ComboBox x:Name="EdgeBox" HorizontalAlignment="Stretch" SelectionChanged="EdgeBox_OnSelectionChanged">
                                <ComboBoxItem x:Name="EdgeTop" Content="上" Tag="Top"/>
                                <ComboBoxItem x:Name="EdgeLeft" Content="左" Tag="Left"/>
                                <ComboBoxItem x:Name="EdgeRight" Content="右" Tag="Right"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="MonitorLabel" Text="显示器" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.LabelGap}"/>
                            <ComboBox x:Name="MonitorBox" HorizontalAlignment="Stretch" SelectionChanged="MonitorBox_OnSelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,24,0,0">
                        <CheckBox x:Name="AutoHideCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="自动隐藏"
                                  Click="AutoHide_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="AutoHideTitle" Text="自动隐藏" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="AutoHideHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="无交互时自动收起至屏幕边缘，避免遮挡最大化窗口。"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <CheckBox x:Name="PeekCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="鼠标靠近边缘热区时自动滑出"
                                  Click="Peek_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="PeekTitle" Text="鼠标靠近边缘热区时自动滑出" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="PeekHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="鼠标指针移入屏幕边缘的感应区域时自动滑出 Dock。"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <CheckBox x:Name="RevealHotkeyCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="全局唤醒快捷键"
                                  Click="RevealHotkey_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="RevealHotkeyTitle" Text="全局唤醒快捷键" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="RevealHotkeyHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="开启后可通过全局快捷键呼出处于隐藏状态的 Dock。若快捷键被占用，可在下方重新录制。"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="RevealHotkeyBox" Style="{StaticResource Settings.TextBox}"
                             Margin="0,8,0,0" HorizontalAlignment="Left" Width="280"
                             IsReadOnly="True" CaretBrush="Transparent"
                             AutomationProperties.Name="唤醒快捷键"
                             GotKeyboardFocus="RevealHotkeyBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="RevealHotkeyBox_OnLostKeyboardFocus"
                             PreviewKeyDown="RevealHotkeyBox_OnPreviewKeyDown"/>
                    <TextBlock x:Name="RevealHotkeyHint" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"/>
                    <DockPanel Margin="0,24,0,0">
                        <CheckBox x:Name="CollapseAppsCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="程序折叠"
                                  Click="CollapseApps_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="CollapseAppsTitle" Text="程序折叠" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="CollapseAppsHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="Dock 上仅显示一个聚合程序图标，点击可展开全部应用程序与快捷方式。"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <CheckBox x:Name="CollapseFoldersCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="文件夹折叠"
                                  Click="CollapseFolders_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="CollapseFoldersTitle" Text="文件夹折叠" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="CollapseFoldersHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="Dock 上仅显示一个聚合文件夹图标，点击可展开全部已钉选的文件夹。"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="LayoutHelp" Style="{StaticResource Settings.Help}" Margin="0,24,0,0"
                               Text="WinDock 默认为贴边居中的悬浮岛，在全屏应用或演示模式下会自动避让。可拖动两端调整宽度，双击边缘可恢复根据内容自适应。在多显示器间拖拽 Dock 会自动同步此处的显示器设置。内容超出屏幕范围时边缘将显示翻页箭头。"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageAppearance" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Settings.PageInset}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="AppearanceTitle" Text="外观" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="AppearanceIntro" Style="{StaticResource Settings.Help}" Margin="0,8,0,24"
                               Text="主题、材质和透明度设置将应用于整个 Dock。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ThemeLabel" Text="主题" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.LabelGap}"/>
                            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="ThemeBox_OnSelectionChanged">
                                <ComboBoxItem x:Name="ThemeSystem" Content="跟随系统" Tag="System"/>
                                <ComboBoxItem x:Name="ThemeLight" Content="浅色" Tag="Light"/>
                                <ComboBoxItem x:Name="ThemeDark" Content="深色" Tag="Dark"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="BackdropLabel" Text="材质" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.LabelGap}"/>
                            <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch" SelectionChanged="BackdropBox_OnSelectionChanged">
                                <ComboBoxItem x:Name="BackdropMica" Content="云母（偏实）" Tag="Mica"/>
                                <ComboBoxItem x:Name="BackdropFrosted" Content="磨砂（雾面）" Tag="Frosted"/>
                                <ComboBoxItem x:Name="BackdropGlass" Content="玻璃（通透）" Tag="Glass"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LanguageLabel" Text="语言" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.SectionLabel}"/>
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="LanguageBox_OnSelectionChanged">
                        <ComboBoxItem x:Name="LanguageSystem" Content="跟随系统" Tag="System"/>
                        <ComboBoxItem x:Name="LanguageChinese" Content="中文" Tag="Chinese"/>
                        <ComboBoxItem x:Name="LanguageEnglish" Content="English" Tag="English"/>
                    </ComboBox>
                    <TextBlock x:Name="LanguageHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                               Text="设置界面语言。设为跟随系统时，在中文 Windows 环境下显示中文，其他语言环境下显示英文。"/>
                    <TextBlock x:Name="TransparencyCaption" Text="Dock 透明度" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.SectionLabel}"/>
                    <DockPanel>
                        <TextBlock x:Name="TransparencyLabel" DockPanel.Dock="Right" Width="40" VerticalAlignment="Center"
                                   Style="{StaticResource Settings.Label}" Text="50%"/>
                        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100" Value="50"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="TransparencySlider_OnValueChanged"/>
                    </DockPanel>
                    <Border x:Name="IslandPreview" Height="56" HorizontalAlignment="Left" Width="280"
                            Margin="0,16,0,0" CornerRadius="8" BorderThickness="1" Padding="5">
                        <Border x:Name="IslandPreviewTile" CornerRadius="4" Padding="10,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="IslandPreviewLabel" Text="预览" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <TextBlock x:Name="AppearanceHelp" Style="{StaticResource Settings.Help}" Margin="0,24,0,0"
                               Text="切换材质会自动应用推荐的预设透明度：云母（偏实）、磨砂（雾面）、玻璃（通透）。设置面板打开时 Dock 将保持常驻，便于即时预览效果。"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PagePrivacy" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Settings.PageInset}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="PrivacyTitle" Text="隐私" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="PrivacyIntro" Style="{StaticResource Settings.Help}" Margin="0,8,0,24"
                               Text="所有权限默认处于关闭状态。关闭权限后对应模块仍保留在 Dock 上，但不再读取相关数据。"/>
                    <DockPanel Margin="0,0,0,16">
                        <CheckBox x:Name="MediaCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="允许读取正在播放的标题和封面"
                                  Click="Privacy_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="MediaPrivacyTitle" Text="允许读取正在播放的标题和封面" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="MediaHint" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,16">
                        <CheckBox x:Name="NetworkCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="允许显示网络适配器名称和速率"
                                  Click="Privacy_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="NetworkPrivacyTitle" Text="允许显示网络适配器名称和速率" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="NetworkPrivacyHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}" Text="数据仅在本地处理，绝不上传网络。"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,16">
                        <CheckBox x:Name="LocationCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="允许使用大致位置自动填写天气城市"
                                  Click="Privacy_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="LocationPrivacyTitle" Text="允许使用大致位置自动填写天气城市" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="LocationPrivacyHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}"
                                       Text="仅在你点击「自动定位」后，通过 HTTPS 查询大致城市。可随时关闭；关闭后只使用已填写的城市。"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <CheckBox x:Name="BingCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="允许从 bing.com 下载壁纸图"
                                  Click="Privacy_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="BingPrivacyTitle" Text="允许从 bing.com 下载壁纸图" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="BingPrivacyHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}" Text="将其设为桌面壁纸时会二次确认。"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="PrivacyHelp" Style="{StaticResource Settings.Help}" Margin="0,24,0,0"
                               Text="未启用崩溃数据上报，所有诊断日志仅保存在本地设备。"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Settings.PageInset}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="AboutTitle" Text="关于" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="AboutBlurb" Style="{StaticResource Settings.Help}" Margin="0,8,0,24"
                               Text="WinDock 是一款轻量贴边桌面悬浮岛，用于快捷启动与情境信息展示。不替换 Windows 任务栏，不以管理员权限运行。"/>
                    <TextBlock x:Name="AboutVersion" Style="{StaticResource Settings.Title}" Margin="{StaticResource Settings.LabelGap}"/>
                    <TextBlock x:Name="AboutPaths" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.SectionGap}"/>
                    <DockPanel>
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource Settings.Toggle}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="开机启动"
                                  Click="Startup_OnClick"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="StartupTitle" Text="开机启动" Style="{StaticResource Settings.Label}"/>
                            <TextBlock x:Name="StartupHelp" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.HelpGap}" Text="仅对当前 Windows 用户生效，不影响其他用户。"/>
                        </StackPanel>
                    </DockPanel>
                    <Button x:Name="AboutExitButton" Content="退出 WinDock" Margin="0,24,0,0"
                            Style="{StaticResource Settings.DangerButton}" HorizontalAlignment="Left" MinWidth="140"
                            Click="NavExit_OnClick"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageProfiles" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Settings.PageInset}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="ProfilesTitle" Text="情景" Style="{StaticResource Settings.Title}"/>
                    <TextBlock x:Name="ProfilesIntro" Style="{StaticResource Settings.Help}" Margin="0,8,0,24"
                               Text="复制情景将完整保留所有钉选启动项与模块配置。可通过本页下拉菜单、系统托盘右键菜单或快捷键进行情景切换。"/>
                    <TextBlock x:Name="CurrentProfileLabel" Text="当前情景" Style="{StaticResource Settings.Label}" Margin="{StaticResource Settings.LabelGap}"/>
                    <DockPanel Margin="{StaticResource Settings.SectionGap}">
                        <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="撤销上一次切换"
                                Style="{StaticResource Settings.Button}" MinWidth="96" Margin="16,0,0,0"
                                VerticalAlignment="Center" Click="Undo_OnClick"/>
                        <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="当前情景"
                                  SelectionChanged="ProfileBox_OnSelectionChanged"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Settings.SectionGap}">
                        <Button x:Name="DuplicateProfileButton" Content="复制当前情景" Style="{StaticResource Settings.Button}" MinWidth="120" Margin="{StaticResource Settings.ButtonGap}" Click="DuplicateProfile_OnClick"/>
                        <Button x:Name="RenameProfileButton" Content="重命名" Style="{StaticResource Settings.Button}" Margin="{StaticResource Settings.ButtonGap}" Click="RenameProfile_OnClick"/>
                        <Button x:Name="DeleteProfileButton" Content="删除" Style="{StaticResource Settings.DestructiveButton}" Click="DeleteProfile_OnClick"/>
                    </StackPanel>
                    <TextBlock x:Name="HotkeyText" Style="{StaticResource Settings.Help}" Margin="{StaticResource Settings.SectionGap}"/>
                    <TextBlock x:Name="RecentSwitchesTitle" Text="最近切换" Style="{StaticResource Settings.Title}" Margin="{StaticResource Settings.LabelGap}"/>
                    <ListBox x:Name="HistoryList" Height="220"/>
                    <TextBlock x:Name="FocusHint" Style="{StaticResource Settings.Help}" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
