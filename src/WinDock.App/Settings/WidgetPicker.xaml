<UserControl x:Class="WinDock.App.WidgetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:WinDock.Widgets;assembly=WinDock.Widgets"
             FontFamily="{x:Static widgets:UiFont.Family}">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar: Search Box and Category Pills -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#14000000" BorderThickness="0,0,0,1" x:Name="TopBarBorder">
            <DockPanel LastChildFill="True">
                <Border x:Name="SearchHost" DockPanel.Dock="Left" Width="210" Background="#FFE8E8EC" CornerRadius="6" Padding="8,5" Margin="0,0,14,0">
                    <DockPanel LastChildFill="True">
                        <widgets:PhosphorGlyph DockPanel.Dock="Left" Icon="magnifying-glass" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="{DynamicResource Settings.Muted}"/>
                        <Button x:Name="SearchClearBtn" DockPanel.Dock="Right" Width="16" Height="16" Margin="4,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"
                                Click="SearchClearBtn_OnClick" Focusable="False">
                            <widgets:PhosphorGlyph Icon="x" Width="10" Height="10" Foreground="{DynamicResource Settings.Muted}"/>
                        </Button>
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="0"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     AutomationProperties.Name="Search widgets"
                                     TextChanged="SearchBox_OnTextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search widgets" IsHitTestVisible="False"
                                       Foreground="#6F6F76" Opacity="0.7" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavHost" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Body: Catalog on Left, Active Widgets Panel on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Catalog of available widgets -->
            <ScrollViewer x:Name="CatalogScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" Padding="0,0,12,0" SizeChanged="CatalogScroll_OnSizeChanged">
                <StackPanel x:Name="CatalogHost"/>
            </ScrollViewer>

            <!-- Active widgets on Dock panel -->
            <Border x:Name="ActiveWidgetsPanel" Grid.Column="1"
                    Background="{DynamicResource Settings.Card}"
                    BorderBrush="{DynamicResource Settings.Stroke}"
                    BorderThickness="1" CornerRadius="8" Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="ActiveWidgetsCount" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Settings.Accent}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveWidgetsTitle" Text="当前挂载的模块" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Settings.Text}"/>
                    </DockPanel>

                    <!-- Mounted Widgets List -->
                    <ScrollViewer x:Name="ActiveWidgetsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ActiveWidgetsHost"/>
                    </ScrollViewer>

                    <!-- Help Text -->
                    <TextBlock x:Name="ActiveWidgetsHelp" Grid.Row="2" FontSize="11" Foreground="{DynamicResource Settings.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="💡 按住并直接拖放卡片可调整在 Dock 上的先后顺序。"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>