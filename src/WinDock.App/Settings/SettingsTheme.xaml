<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:WinDock.Core;assembly=WinDock.Core">
    <SolidColorBrush x:Key="Settings.Page" Color="#FFF4F4F6"/>
    <SolidColorBrush x:Key="Settings.BgPrimary" Color="#FFF4F4F6"/>
    <SolidColorBrush x:Key="Settings.Card" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Settings.Stroke" Color="#14000000"/>
    <SolidColorBrush x:Key="Settings.BorderDefault" Color="#14000000"/>
    <SolidColorBrush x:Key="Settings.BorderStrong" Color="#33000000"/>
    <SolidColorBrush x:Key="Settings.Text" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Settings.Muted" Color="#FF6F6F76"/>
    <SolidColorBrush x:Key="Settings.FgDisabled" Color="#FFB0B0B5"/>
    <SolidColorBrush x:Key="Settings.NavPane" Color="#FFF4F5F7"/>
    <SolidColorBrush x:Key="Settings.NavSelected" Color="#FFE6E6EA"/>
    <SolidColorBrush x:Key="Settings.Catalog" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Settings.Preview" Color="#FFF1F2F4"/>
    <SolidColorBrush x:Key="Settings.Search" Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="Settings.BgSecondary" Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="Settings.Accent" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="Settings.AccentHover" Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="Settings.OnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Settings.FocusRing" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="Settings.Danger" Color="#FFE11D48"/>
    <SolidColorBrush x:Key="Settings.DangerSubtle" Color="#14E11D48"/>
    <SolidColorBrush x:Key="Settings.ScrollThumb" Color="#59000000"/>
    <SolidColorBrush x:Key="Settings.ScrollThumbHover" Color="#8A000000"/>
    <SolidColorBrush x:Key="Settings.ScrollThumbPressed" Color="#B3000000"/>
    <Thickness x:Key="Settings.PageInset">24,24,24,24</Thickness>
    <Thickness x:Key="Settings.LabelGap">0,0,0,8</Thickness>
    <Thickness x:Key="Settings.SectionLabel">0,24,0,8</Thickness>
    <Thickness x:Key="Settings.SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="Settings.HelpGap">0,8,0,0</Thickness>
    <Thickness x:Key="Settings.ButtonGap">0,0,8,0</Thickness>
    <Thickness x:Key="Settings.ControlPad">12,0,12,0</Thickness>

    <Style x:Key="Settings.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource Settings.FocusRing}"
                               StrokeThickness="{x:Static core:DockTokens+Settings.FocusRingThickness}"
                               RadiusX="6"
                               RadiusY="6"
                               Margin="-3"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Settings.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Settings.Help" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Muted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Settings.NavTitle" TargetType="TextBlock" BasedOn="{StaticResource Settings.Title}">
        <Setter Property="Margin" Value="8,0,8,16"/>
    </Style>
    <Style x:Key="Settings.NavGroup" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="8,16,8,8"/>
    </Style>
    <Style x:Key="Settings.NavGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.78"/>
    </Style>
    <Style x:Key="Settings.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.Button" TargetType="Button">
        <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Settings.BgSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Settings.ControlPad}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Settings.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Settings.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Settings.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.AccentHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.BgSecondary}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.DestructiveButton" TargetType="Button" BasedOn="{StaticResource Settings.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Danger}"/>
        <Setter Property="Background" Value="{DynamicResource Settings.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.Danger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.DangerSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.DangerButton" TargetType="Button" BasedOn="{StaticResource Settings.DestructiveButton}"/>
    <Style x:Key="Settings.GhostButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.TextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Settings.BgSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Settings.ControlPad}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Settings.BgSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Settings.ControlPad}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Settings.BgSecondary}"
                                BorderBrush="{DynamicResource Settings.BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <Path DockPanel.Dock="Right"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L8,0"
                                      Stroke="{DynamicResource Settings.Muted}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <ContentPresenter Margin="12,0,8,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            </DockPanel>
                        </Border>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,8"
                                    Padding="4"
                                    Background="{DynamicResource Settings.Card}"
                                    BorderBrush="{DynamicResource Settings.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="16,8"
                                BorderBrush="{DynamicResource Settings.BorderDefault}"
                                BorderThickness="0,0,0,1"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Muted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="{x:Static core:DockTokens+Settings.TabMinWidth}"/>
        <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="MinHeight" Value="{x:Static core:DockTokens+Settings.ControlHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            MinWidth="{TemplateBinding MinWidth}"
                            Height="{x:Static core:DockTokens+Settings.ControlHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Settings.BgSecondary}"
                                BorderBrush="{DynamicResource Settings.BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="Mark"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource Settings.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Settings.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Settings.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Settings.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="24" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                CornerRadius="12"
                                Background="{DynamicResource Settings.BgSecondary}"
                                BorderBrush="{DynamicResource Settings.BorderDefault}"
                                BorderThickness="1"/>
                        <Ellipse x:Name="Thumb"
                                 Width="16"
                                 Height="16"
                                 HorizontalAlignment="Left"
                                 Margin="4,0"
                                 Fill="{DynamicResource Settings.Card}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Settings.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Settings.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Settings.Accent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Settings.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.7"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Settings.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource Settings.Accent}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" FocusVisualStyle="{x:Null}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Settings.Accent}"
                                                     Stroke="{DynamicResource Settings.Card}"
                                                     StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource Settings.BgSecondary}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.NavSelected}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Settings.BgSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderDefault}"/>
        <Setter Property="Foreground" Value="{DynamicResource Settings.Text}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.ListBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="0" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Settings.FocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.ScrollThumbVertical" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="0,2">
                        <Border x:Name="Pill"
                                Width="{x:Static core:DockTokens+Settings.ScrollThumbSize}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Settings.ScrollThumb}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Settings.ScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Settings.ScrollThumbPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.ScrollThumbHorizontal" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="2,0">
                        <Border x:Name="Pill"
                                Height="{x:Static core:DockTokens+Settings.ScrollThumbSize}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Settings.ScrollThumb}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Settings.ScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Settings.ScrollThumbPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Settings.ScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Settings.ScrollPage}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Settings.ScrollPage}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Settings.ScrollThumbVertical}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="Settings.ScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Settings.ScrollPage}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Settings.ScrollPage}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Settings.ScrollThumbHorizontal}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{x:Static core:DockTokens+Settings.ScrollThickness}"/>
        <Setter Property="MinWidth" Value="{x:Static core:DockTokens+Settings.ScrollThickness}"/>
        <Setter Property="Template" Value="{StaticResource Settings.ScrollBarVertical}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="{x:Static core:DockTokens+Settings.ScrollThickness}"/>
                <Setter Property="MinHeight" Value="{x:Static core:DockTokens+Settings.ScrollThickness}"/>
                <Setter Property="Template" Value="{StaticResource Settings.ScrollBarHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
